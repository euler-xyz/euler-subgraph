{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/euler-xyz/euler-subgraph/catalog/v1/schema.json",
  "title": "Euler Subgraph catalog v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "publishedAt",
    "deployments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chainId",
          "family",
          "channel",
          "status"
        ],
        "properties": {
          "chainId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\.(0|[1-9]\\d*))?$"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#@]+(?:/[^?#]*)?$"
          },
          "deploymentId": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "interfacesCommit": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40}$"
          },
          "startBlock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "active"
                }
              }
            },
            "then": {
              "required": [
                "version",
                "endpoint",
                "deploymentId",
                "capabilities"
              ]
            }
          }
        ]
      }
    }
  }
}
