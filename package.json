{
  "name": "euler-v2",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "pnpm": "9.12.3"
  },
  "scripts": {
    "codegen": "graph codegen",
    "build": "bun scripts/network.ts build",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "verify:accountPositions": "bun ./verify/checkAccountPositions.ts",
    "verify:accountVaultBalances": "bun ./verify/checkAccountVaultBalances.ts",
    "test": "graph test",
    "tag:deployments": "bun scripts/tag-deployments.ts",
    "generate:deployments": "bun scripts/generate-deployments.ts",
    "deploy:hotfix": "bun scripts/deploy-hotfix.ts",
    "catalog:publish": "bun scripts/catalog/cli.ts publish",
    "test:catalog": "node --test tests/catalog/*.test.mjs",
    "catalog:retire": "bun scripts/catalog/cli.ts retire",
    "catalog:promote": "bun scripts/catalog/cli.ts promote",
    "test:catalog:consumers": "node --import ./tests/consumers/loader.mjs --test tests/consumers/catalog.test.mjs",
    "catalog:import": "bun scripts/catalog/cli.ts import",
    "prepare": "bun scripts/network.ts prepare",
    "deploy": "bun scripts/network.ts deploy"
  },
  "dependencies": {
    "@types/node": "^22.13.10",
    "env-cmd": "^10.1.0",
    "matchstick-as": "0.6.0",
    "mustache": "^4.2.0",
    "viem": "^2.22.22"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.87.0",
    "@graphprotocol/graph-ts": "0.33.0",
    "@types/node": "^22.13.10",
    "assemblyscript": "^0.19.10"
  }
}
